<?xml version="1.0" encoding="utf-8"?>
<customUI xmlns="http://schemas.microsoft.com/office/2006/01/customui" loadImage="LoadImage">
  <ribbon startFromScratch="false">
    <tabs>
      <tab idMso="TabReadMessage">
        <group id="AIAssistantGroup" label="AI Assistant">
          <button id="SettingsButton"
                  label="Settings"
                  image="settings"
                  size="large"
                  onAction="OnSettingsClick"
                  screentip="Configure AI Service"
                  supertip="Configure AI service provider, API key, and default settings"/>

          <button id="TranslateButton"
                  label="Translate"
                  image="translate"
                  size="large"
                  onAction="OnTranslateClick"
                  screentip="Translate Email"
                  supertip="Translate the current email content to target language"/>

          <button id="SummaryButton"
                  label="Summary"
                  image="summary"
                  size="large"
                  onAction="OnSummaryClick"
                  screentip="Summarize Email"
                  supertip="Generate a summary of the current email"/>

          <button id="ReplyButton"
                  label="Reply"
                  image="reply"
                  size="large"
                  onAction="OnReplyClick"
                  screentip="Generate Reply"
                  supertip="Generate an AI-powered reply suggestion"/>

          <button id="PolishButton"
                  label="Polish"
                  image="polish"
                  size="large"
                  onAction="OnPolishClick"
                  screentip="Polish Email"
                  supertip="Polish and improve the current email draft"/>
        </group>
      </tab>

      <!-- Also add to compose message tab -->
      <tab idMso="TabCompose">
        <group id="ComposeAIAssistantGroup" label="AI Assistant">
          <button id="ComposePolishButton"
                  label="Polish"
                  image="polish"
                  size="large"
                  onAction="OnPolishClick"
                  screentip="Polish Draft"
                  supertip="Polish and improve your email draft"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>