@="d:\\Work\\OutlookPlugin\\csharp\\bin\\Release\\net9.0-windows\\AIAssistant.comhost.dll"
"ThreadingModel"="Both"

[HKEY_CURRENT_USER\Software\Classes\AIAssistant]
